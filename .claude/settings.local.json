{
  "permissions": {
    "allow": [
      "Bash(rm:*)",
      "Bash(open:*)",
      "Bash(test:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(./scripts/append-prompt.sh:*)",
      "Bash(cat:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/append-prompt.sh"
          }
        ]
      }
    ]
  }
}
